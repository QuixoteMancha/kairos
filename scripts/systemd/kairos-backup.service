[Unit]
Description=Kairos SQLite online backup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/sandman/Programas2/python/projects/kairos
ExecStart=/home/sandman/Programas2/python/projects/kairos/env/bin/python scripts/backup_db.py --keep 30
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
