# ============================================================
# KAIROS — Variables de entorno
# Copiar como .env y completar sólo lo que necesites.
# Nunca subir .env al repositorio (está en .gitignore).
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
# Docker Compose configura DB_HOST y los nombres de base automáticamente.
POSTGRES_PASSWORD=cambiar-esta-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=kairos
# DB_PASSWORD=cambiar-esta-password
# DB_NAME=kairos
# DB_HISTORICAL_NAME=kairos_historical

# ── Imagen Docker ─────────────────────────────────────────────
# Todos los servicios usan el mismo tag (ver scripts/deploy_kairos_stack.sh).
KAIROS_IMAGE_TAG=dev

# ── Kalshi (lectura autenticada de portfolio) ─────────────────
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=           # PEM o ruta al archivo .pem

# ── Proxy residencial para scrapers (opcional) ────────────────
# BRIGHTDATA_PROXY=http://usuario:password@host:puerto

# ── Alertas por correo (opcional) ─────────────────────────────
# Gmail: usar una "contraseña de aplicación", nunca la contraseña normal.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# ALERT_EMAIL_TO=               # default = SMTP_USER
# ALERT_EMAIL_FROM=             # default = SMTP_USER

# ── Geocodificación (Nominatim exige un contacto válido) ──────
# NOMINATIM_CONTACT=tu-correo@ejemplo.com

# ── Despliegue (scripts/deploy_minipc.sh) ─────────────────────
# KAIROS_DEPLOY_HOST=

# ── Captura de mercados climáticos ────────────────────────────
WEATHER_HISTORY_START_YEAR=2024
WEATHER_CAPTURE_REQUEST_BUDGET=32
WEATHER_MARKET_CAPTURE_INTERVAL_SECONDS=900
WEATHER_FORECAST_MODELS=gfs_seamless,ecmwf_ifs025,gfs_hrrr

# ── Laboratorio ML de tenis (sólo investigación) ──────────────
# TENNIS_ML_INTERVAL_SECONDS=86400
# TENNIS_ML_ARTIFACT_DIR=/data/ml/tennis

# ── Logging ───────────────────────────────────────────────────
# LOG_LEVEL=INFO
