# ============================================================
# KAIROS — Variables de entorno
# Copiar como .env y rellenar con los valores reales.
# NUNCA commitear .env al repo (ya está en .gitignore).
# ============================================================

# ── Proxy Brightdata (residencial — para Sofascore/Tennisstats) ──
# brightdata.com → Proxies & Scraping → Residential → Access Parameters
# Puerto 33335 = SSL | 22225 = sin SSL
BRIGHTDATA_PROXY=http://brd-customer-XXXXXXXX-zone-residential_proxy1:PASSWORD@brd.superproxy.io:33335

# ── Proxy para sitios de gambling (Bet365, Betano, etc.) ─────
# Brightdata bloquea gambling por defecto. Usar Smartproxy, ProxyEmpire o IPRoyal.
# Dejar vacío = se omite (Playwright funciona sin proxy si la IP no está bloqueada).
# GAMBLING_PROXY=http://user:pass@gate.smartproxy.com:7000

# ── Bet365 ────────────────────────────────────────────────────
# BET365_USERNAME=tu@email.com
# BET365_PASSWORD=tupassword
# BET365_HEADLESS=true          # false = ver el browser (necesario para 2FA la primera vez)
# BET365_2FA_WAIT_SEC=120       # segundos de espera para ingresar el código SMS
# BET365_SESSION_FILE=data/bet365_session.json

# ── Betfair Exchange ──────────────────────────────────────────
# BETFAIR_APP_KEY=              # developer.betfair.com → API Keys (App Key "Delay" = gratis)
# BETFAIR_USERNAME=
# BETFAIR_PASSWORD=

# ── The Odds API (fallback multi-book) ───────────────────────
# the-odds-api.com → free tier 500 req/mes
# ODDS_API_KEY=

# ── Telegram (alertas) ───────────────────────────────────────
# TELEGRAM_BOT_TOKEN=           # @BotFather → /newbot
# TELEGRAM_CHAT_ID=             # habla al bot → api.telegram.org/bot<TOKEN>/getUpdates

# ── API Keys de LLM ──────────────────────────────────────────
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Base de datos ─────────────────────────────────────────────
# DB_PATH=/ruta/personalizada/kairos.db

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Docker Compose: puertos host y Grafana ───────────────────
# TZ=Europe/Madrid
# KAIROS_PORT=8765
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin       # CAMBIÁ esto antes de exponer a internet
