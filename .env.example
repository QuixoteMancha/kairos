# ============================================================
# KAIROS — Variables de entorno
# Copiar como .env y rellenar con los valores reales.
# NUNCA commitear .env al repo (ya está en .gitignore).
# ============================================================

# ── Proxy Brightdata (residencial — para Sofascore/Tennisstats) ──
# brightdata.com → Proxies & Scraping → Residential → Access Parameters
# Puerto 33335 = SSL | 22225 = sin SSL
BRIGHTDATA_PROXY=http://brd-customer-XXXXXXXX-zone-residential_proxy1:PASSWORD@brd.superproxy.io:33335

# ── Proxy para sitios de gambling (Bet365, Betano, etc.) ─────
# Brightdata bloquea gambling por defecto. Usar Smartproxy, ProxyEmpire o IPRoyal.
# Dejar vacío = se omite (Playwright funciona sin proxy si la IP no está bloqueada).
# GAMBLING_PROXY=http://user:pass@gate.smartproxy.com:7000

# ── Bet365 ────────────────────────────────────────────────────
# BET365_USERNAME=tu@email.com
# BET365_PASSWORD=tupassword
# BET365_HEADLESS=true          # false = ver el browser (necesario para 2FA la primera vez)
# BET365_2FA_WAIT_SEC=120       # segundos de espera para ingresar el código SMS
# BET365_SESSION_FILE=data/bet365_session.json

# ── Betfair Exchange ──────────────────────────────────────────
# BETFAIR_APP_KEY=              # developer.betfair.com → API Keys (App Key "Delay" = gratis)
# BETFAIR_USERNAME=
# BETFAIR_PASSWORD=

# ── The Odds API (fallback multi-book) ───────────────────────
# the-odds-api.com → free tier 500 req/mes
# ODDS_API_KEY=

# ── Telegram (alertas) ───────────────────────────────────────
# TELEGRAM_BOT_TOKEN=           # @BotFather → /newbot
# TELEGRAM_CHAT_ID=             # habla al bot → api.telegram.org/bot<TOKEN>/getUpdates

# ── Alertas por correo (2026-08-11, pedido explícito del usuario:      ──
# ── "si no funciona con el proxy o no hay dinero en el proxy" ──
# Gmail: activar 2FA en la cuenta remitente y generar una "Contraseña de
# aplicación" (myaccount.google.com/apppasswords) -- NUNCA usar la
# contraseña normal de la cuenta acá.
# SMTP_USER=                    # cuenta remitente (ej. tu-bot@gmail.com)
# SMTP_PASSWORD=                # contraseña de APLICACIÓN de Gmail, no la normal
# SMTP_HOST=smtp.gmail.com      # default si se omite
# SMTP_PORT=587                 # default si se omite
# ALERT_EMAIL_TO=alertas@example.com   # default si se omite (pedido explícito)
# ALERT_EMAIL_FROM=             # default = SMTP_USER si se omite

# ── API Keys de LLM ──────────────────────────────────────────
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── PostgreSQL ────────────────────────────────────────────────
# Docker Compose configura DB_HOST y los nombres automáticamente.
# Cambiar esta contraseña antes de instalar en la mini-pc.
POSTGRES_PASSWORD=cambiar-esta-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=kairos
# DB_PASSWORD=cambiar-esta-password
# DB_NAME=kairos
# DB_HISTORICAL_NAME=kairos_historical
# KAIROS_DB_BACKEND no es configurable en despliegues: las bases activas
# de Kairos usan exclusivamente PostgreSQL.

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Laboratorio ML tenis (solo investigación; promoción manual) ──
# TENNIS_ML_INTERVAL_SECONDS=86400
# TENNIS_ML_ARTIFACT_DIR=/data/ml/tennis

# ── Docker Compose: puertos host y Grafana ───────────────────
# TZ=Europe/Madrid
# KAIROS_PORT=8765
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin       # CAMBIÁ esto antes de exponer a internet
KAIROS_IMAGE_TAG=20260817-flashscore-v28
